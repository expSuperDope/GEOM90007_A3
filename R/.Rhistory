group = "City Circle Tram Stops",
popup = tram_data$name,
icon = tram_icon  # Apply tram stop icon
)
base_map <- base_map %>%
addMarkers(
lng = landmark_data$lng, lat = landmark_data$lat,
group = "Landmarks",
popup = paste0("Name: ", landmark_data$Feature.Name, "<br>",
